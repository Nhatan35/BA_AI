# Copy to .env. Supply private credentials generated by database setup.
DATABASE_URL=postgresql+psycopg://medical_app:REPLACE_ME@127.0.0.1:55432/medical_ba
MIGRATION_DATABASE_URL=postgresql+psycopg://medical_owner:REPLACE_ME@127.0.0.1:55432/medical_ba
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_HOURS=8
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# Phase 2: TECHNICAL DEFAULT — CONFIGURABLE. Restart backend after changes.
# STORAGE_ROOT defaults to workspace/var/storage; keep it outside public web roots.
UPLOAD_MAX_BYTES=10485760
CSV_MAX_ROWS=10000
SPREADSHEET_MAX_SHEETS=20
SPREADSHEET_MAX_ROWS=10000
SPREADSHEET_MAX_COLUMNS=256
PARSE_MAX_CHARACTERS=2000000
PARSE_MAX_SECTIONS=50000
PARSE_MAX_PAGES=500
PARSE_MAX_EXPANDED_BYTES=52428800
PARSE_TIMEOUT_SECONDS=30
PARSE_MAX_CONCURRENT=2
